# ---------------------------------------------------------------------------
# Backend Environment Variables
# Copy this file to .env and fill in real values before running.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL (matches docker-compose service "postgres")
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/inventory_db?schema=public"

# Redis (matches docker-compose service "redis")
REDIS_URL="redis://redis:6379"

# JWT
JWT_ACCESS_SECRET="change-this-to-a-long-random-string"
JWT_REFRESH_SECRET="change-this-to-a-different-long-random-string"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

COOKIE_SECRET="change-this-cookie-secret"

# SMTP (for password reset / notification emails). Leave blank to disable emails.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@inventory.io"

# URLs
CLIENT_URL="http://localhost:5173"
AI_SERVICE_URL="http://ai-service:8000"

# File uploads
UPLOAD_DIR="uploads"

# Optional: Cloudinary / S3 (if you swap local disk storage for cloud storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_REGION="ap-south-1"
