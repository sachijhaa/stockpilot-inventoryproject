# Vite only exposes variables prefixed with VITE_ to the client bundle.
# In development, Vite's dev-server proxy (see vite.config.ts) forwards
# /api and /socket.io to the backend, so this is usually not required
# locally. Set it when building a static bundle that must call a
# non-relative backend URL (e.g. separate domains in production).

VITE_API_BASE_URL=/api
VITE_SOCKET_URL=/
